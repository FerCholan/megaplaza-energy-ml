# Base de Datos PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/megaplaza_energy
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=megaplaza_energy
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Megaplaza Energy ML
DEBUG=True

# ML Models
MODEL_PATH=ml/models/
CLUSTERING_MODEL=clustering_model.pkl
FORECASTING_MODEL=forecasting_model.pkl

# Email Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=admin@megaplaza.com

# Frontend
BACKEND_URL=http://localhost:8000
STREAMLIT_SERVER_PORT=8501
